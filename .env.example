# Copia este archivo a .env (no se sube a GitHub) o pon estas variables en Vercel / Render.
LALIGA_EMAIL=tu-email@ejemplo.com
LALIGA_PASSWORD=tu-contraseña
# Nombre de la liga (si tienes varias). Si no coincide, se usa la primera.
LALIGA_LEAGUE=mi-liga
# Contraseña para abrir la app (recomendado: la URL es pública).
APP_PASSWORD=
# Secreto para el refresco automático (Vercel Cron lo envía solo). Cadena aleatoria de 16+ caracteres.
CRON_SECRET=
# Solo Vercel: lo añade Vercel al conectar un Blob store.
# BLOB_READ_WRITE_TOKEN=

# Habla con la IA (nivel gratis de Google AI Studio: https://aistudio.google.com/apikey).
# Sin esta clave la sección de IA responde "aún no está activada" y el resto de la app sigue igual.
GEMINI_API_KEY=
# Opcionales: modelo (por defecto gemini-3.5-flash-lite, el del nivel gratis de 500 peticiones/día)
# y tope de preguntas por usuario y día (por defecto 10).
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_DAILY_LIMIT=10

